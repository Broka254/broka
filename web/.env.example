# The BROKA API (the Azure Container App). Read on the server only.
# Render (https://broka-dbjd.onrender.com) is the fallback.
BROKA_API_URL=https://broka-api.redhill-7a4b8acc.southafricanorth.azurecontainerapps.io

# Shared with the API (STOREFRONT_API_KEY in its environment): the same 32+
# random characters in both. Server only - never NEXT_PUBLIC_. With it, the
# store visit and share counts this site forwards carry the visitor's own
# address, so the API's per-visitor limits work; without it they are limited
# by Vercel's addresses, shared between every web visitor.
STOREFRONT_API_KEY=

# Shared with the BROKA website's Vercel project (its STOREFRONT_PROXY_KEY):
# the same 32+ random characters in both. Server only - never NEXT_PUBLIC_.
# broka.co.ke is the website, which passes store links on to this project;
# with the key it also tells this site each visitor's address, so the visit
# and share counts above are limited per visitor, not per website server.
STOREFRONT_PROXY_KEY=

# This site's own address: canonical links and link previews. Keep it
# https://broka.co.ke even though this project has its own *.vercel.app
# address: visitors reach it through the website there.
NEXT_PUBLIC_SITE_URL=https://broka.co.ke

# Where "Get the app" goes. Defaults to the latest APK on GitHub releases.
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://github.com/Xxavier-ml/broka/releases/latest/download/broka-release.apk

# Android App Links: SHA-256 fingerprints of the app's signing certificate,
# comma-separated (keytool -list -v -keystore <release keystore>). Until set,
# store links still open in the app from the "Open in the app" button.
ANDROID_CERT_SHA256=

# iOS Universal Links, once there is an iOS build: <TeamID>.com.broka.app
APPLE_APP_IDS=
