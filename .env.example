# ─────────────────────────────────────────────────────────────────
# BROKA v4.0 — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
ENV=development         # development | staging | production
DEBUG=false

# ── Auth ─────────────────────────────────────────────────────────
SECRET_KEY=replace_with_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ─────────────────────────────────────────────────────
# Dev: SQLite (auto-created). Production: PostgreSQL only.
DATABASE_URL=sqlite+aiosqlite:///./broka.db
# Production: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/broka
# `?sslmode=require` is accepted (passed to asyncpg as ssl=require). Supabase:
# use its Session pooler string (port 5432, IPv4); the direct db.<ref> host is
# IPv6-only unless you buy its IPv4 add-on. The transaction pooler (6543)
# works too: prepared statements are switched off for it automatically.
# URL-encode @ : / # in the password. GET /ready shows the database in use.
# Connection pool size for that Postgres connection - tune to your actual
# plan's connection cap (e.g. Render's managed Postgres tiers each have a
# max connection count; pool_size+max_overflow times your number of running
# instances/workers must stay under it). Ignored entirely on SQLite.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis (v4.0 — highly recommended for production) ─────────────
# Enables: Redis Streams event bus, distributed rate limiting,
#          ARQ background workers, idempotency keys, AI response cache.
# Without this, everything falls back to single-instance in-process mode.
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ──────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_key

# DeepSeek V4 Flash — DIRECT API (not via OpenRouter). Sits between Gemini
# and OpenRouter/Nemotron below, added specifically to test whether it beats
# the current Nemotron path on latency for conversational Zeno responses.
# Get a key at https://platform.deepseek.com/api_keys. Safe to leave unset -
# the app skips straight to OpenRouter/Nemotron if this key is absent.
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Deliberately shorter than the other providers (25-30s) - a slow DeepSeek
# response should fail fast onto Nemotron rather than make Zeno feel slower
# than it already does today.
DEEPSEEK_TIMEOUT_SECONDS=15

# OpenRouter — TESTING (2026-08): standing in for Groq below, after Groq
# decommissioned llama-3.3-70b-versatile on 2026-08-16. Free tier, OpenAI-
# compatible. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_with_your_openrouter_key
# Swap models without a redeploy - other candidates being evaluated for
# Zeno are openai/gpt-oss-20b:free and google/gemma-4-26b-a4b-it:free.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Legacy fallback - llama-3.3-70b-versatile was decommissioned by Groq on
# 2026-08-16, so this tier is currently a no-op. The model name is
# hardcoded (not env-driven) in negotiate.py / disputes.py /
# domains/disputes/service.py / core/config.py - update GROQ_MODEL there
# to a Groq model still being served (Groq's own suggested replacements:
# GPT-OSS-120B / Qwen3.6 27B) to reactivate this tier. Key kept here, not removed.
GROQ_API_KEY=gsk_replace_with_your_groq_key

# SMS — phone OTP delivery + SMS availability nudges.
# Two providers are supported (api/core/sms.py); Mobitech is tried first,
# Africa's Talking is the fallback, and if neither is configured OTPs/
# nudges are logged instead of actually sent in dev/CI. In production they
# FAIL instead (never logged) — see ConsoleSMS in api/core/sms.py.
#
# Mobitech Technologies (https://textapi.mobitechtechnologies.com) — get
# your key from the dashboard's Developers/Settings page. No sandbox mode:
# once both vars below are set, sends are live and billed immediately.
MOBITECH_API_KEY=replace_with_your_mobitech_api_key
MOBITECH_SENDER_NAME=replace_with_your_sender_name
# Only needed if Mobitech ever asks you to switch API hosts. Must be just
# the domain, no path - a path baked in here plus MOBITECH_SEND_ENDPOINT
# below produces a broken doubled-up URL (validate_startup() warns loudly
# if this happens; it's exactly what broke OTP sending in production
# once already).
# MOBITECH_BASE_URL=https://textapi.mobitechtechnologies.com
# Empirically confirmed working endpoint+payload shape for this account -
# see api/core/sms.py's MobitechSMS docstring before changing this.
# MOBITECH_SEND_ENDPOINT=/sms/sendsms

# Africa's Talking — fallback provider, used only when the Mobitech vars
# above are left blank. Use "sandbox" while testing (routes to the AT
# sandbox simulator and only reaches numbers you've registered there);
# your live AT username in prod.
AT_USERNAME=sandbox
AT_API_KEY=replace_with_your_at_api_key
AT_SENDER_ID=

# ── Email (Resend — email verification codes) ─────────────────────
# Email is OPTIONAL at signup, so the app works fully without these. In
# dev/CI the codes are logged instead of sent; in production, verification
# requests return 503 instead (codes are never logged) — same as SMS.
#
# RESEND_FROM must be an address on a domain you have verified in the
# Resend dashboard (Domains -> Add Domain, then add the DKIM/SPF records
# it gives you). Resend rejects a send from an unverified domain outright,
# which is the usual cause of "the code never arrived". Until your domain
# is verified you can use Resend's own onboarding@resend.dev, but that can
# only deliver to the address that owns the Resend account.
RESEND_API_KEY=
RESEND_FROM=BROKA <noreply@yourdomain.com>
# Optional. Where replies go if a user hits reply on a verification email.
RESEND_REPLY_TO=

# ── M-Pesa (Daraja API) ───────────────────────────────────────────
MPESA_ENV=sandbox                       # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/callback/CHANGE_ME_TO_MATCH_SECRET_BELOW
# Safaricom can't sign its webhook payloads, so this secret path segment is
# how /mpesa/callback, /verify/callback, and /featured/callback each
# authenticate the caller - without it, anyone who discovers a callback URL
# could POST a fake "payment succeeded" event (mark a deal paid, grant free
# verification, or boost a listing for free, with no real M-Pesa payment).
# One secret protects all three routes. Generate a long random value, put it
# here AND as the last path segment of MPESA_CALLBACK_URL above (e.g.
# .../mpesa/callback/<this value>), then register that full URL - and the
# equivalent /verify/callback/<this value> and /featured/callback/<this
# value> URLs - with Safaricom. Required in production: validate_startup()
# now refuses to start without this set, since leaving it blank means all
# three routes stay on their unauthenticated fallback path.
MPESA_CALLBACK_SECRET=
MPESA_VERIFY_CALLBACK_URL=https://your-domain.com/verify/callback
MPESA_FEATURED_CALLBACK_URL=https://your-domain.com/featured/callback
# Listing-fee payments (PRICING.md). Leave unset to use
# https://broka-dbjd.onrender.com/pricing/listing-fee/callback/<MPESA_CALLBACK_SECRET>.
MPESA_LISTING_FEE_CALLBACK_URL=
# Plan payments. Leave unset to use .../premium/callback/<MPESA_CALLBACK_SECRET>.
MPESA_PREMIUM_CALLBACK_URL=
MPESA_B2C_INITIATOR=
MPESA_B2C_CREDENTIAL=
MPESA_B2C_TIMEOUT_URL=https://your-domain.com/mpesa/b2c/timeout
MPESA_B2C_RESULT_URL=https://your-domain.com/mpesa/b2c/result

# ── E-Confirm API v2 (marketplace escrow — 2026-09) ────────────────
# Replaces direct-Daraja funding/release for NEW marketplace deals only;
# the M-Pesa config above is untouched and still used for featured/
# verification payments and legacy B2C dispute refunds. Same API key as
# E-Confirm API v1 per the developer portal — this integration only uses
# v2 endpoints (see api/core/econfirm_client.py). Required in production
# (see core/config.py's validate_startup) — never required for local/test,
# EConfirmClient raises a clear per-call error instead, and every
# automated test mocks the provider (backend/tests/test_escrow.py).
ECONFIRM_API_KEY=
ECONFIRM_BASE_URL=https://api.econfirm.co.ke/api/2
ECONFIRM_TIMEOUT_SECONDS=20
ECONFIRM_POLL_INTERVAL_SECONDS=4
ECONFIRM_MAX_POLL_SECONDS=180

# ── Images: Cloudflare R2 ────────────────────────────────────────
# Listing, store and profile images are processed into WebP sizes and stored
# in R2, served from MEDIA_PUBLIC_BASE_URL (the bucket's public custom domain,
# e.g. https://media.broka.co.ke, or its https://pub-....r2.dev URL). The
# access key needs Object Read & Write on this bucket only. Leave any of the
# five empty and images are stored in the database instead - fine locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
# This API's own public URL (e.g. https://broka-dbjd.onrender.com). Only used
# for images stored in the database, to give them absolute URLs.
PUBLIC_API_BASE_URL=

# Base of every store's shareable link: {STORE_LINK_BASE}/{link name}.
# Production uses broka.co.ke; change it only for a staging copy.
STORE_LINK_BASE=https://broka.co.ke/store

# ── Client addresses (api/core/client_ip.py) ─────────────────────
# Per-IP rate limits (login, signup, OTP, store visit counting) need the
# caller's real address. Behind a proxy the TCP peer is the proxy.
#   CLIENT_IP_HEADER    a header your edge sets and callers can't forge.
#                       Defaults to CF-Connecting-IP on Render; "none" = off.
#   TRUSTED_PROXY_HOPS  elsewhere: proxies appending to X-Forwarded-For.
# Check the result with GET /admin/diagnostics/client-ip (admin only).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
# Shared with the web storefront (web/.env.example): 32+ random characters,
# the same value in both. Lets it pass on which visitor a store visit or
# share came from. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
STOREFRONT_API_KEY=
# Largest request body accepted at all, in MB (api/core/body_limit.py). Above
# the biggest legitimate upload (25 MB of audio for transcription).
MAX_REQUEST_BODY_MB=32
# The Rust extension (backend/native, api/core/native.py). auto (default): use
# it when it is installed and built from this checkout, else the Python
# fallback - same results, slower. required: refuse to start without it (the
# Docker image sets this). off: never load it - the kill switch.
# BROKA_NATIVE=auto

# ── Observability (v4.0) ──────────────────────────────────────────
# Error tracking AND money alerts: every reconciliation alert (a payment on a
# cancelled deal, an E-Confirm deal a timer/chat was not allowed to settle,
# an unrecognised provider status) is raised to Sentry, one issue per
# (kind, deal), tagged alert=reconciliation. Set this in production and add
# a Sentry alert rule on that tag. See api/core/reconciliation.py.
SENTRY_DSN=
JSON_LOGS=false       # set true in production for structured log ingestion

# ── Security ─────────────────────────────────────────────────────
ZAC_SECRET=replace_with_64_char_random_string
ADMIN_BOOTSTRAP_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Firebase (optional — FCM push notifications) ─────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Cloudflare Realtime TURN (VoIP calling — audio/video relay) ──
# Powers GET /calls/turn-credentials (api/core/cloudflare_turn_client.py),
# which WebRtcService calls before creating each RTCPeerConnection.
# Replaces the previous hardcoded third-party (Metered) TURN credential
# that used to live directly in Flutter. Without these set, calls still
# work wherever direct P2P ICE connectivity succeeds - they just can't
# fall back to a relay on carrier-grade NAT (see validate_startup()'s
# warning in api/core/config.py).
# Create a TURN key in the Cloudflare dashboard (Realtime > TURN) to get
# the key ID + API token below.
CLOUDFLARE_TURN_KEY_ID=
# Server-side only - never returned to Flutter, never logged.
CLOUDFLARE_TURN_API_TOKEN=
# Not used by the credential-generation call itself - only needed if a
# future administrative Cloudflare call requires it.
CLOUDFLARE_ACCOUNT_ID=

# ── Marketplace Redesign (Design Journal Volume 6, Appendix C) ────
BUY_AGENT_MAX_ACTIVE=1   # per-buyer cap on standing Buy-Agent requests, Ch.8/Ch.22 — do not raise without also updating BuyAgentService.get_active_for_buyer, which assumes a single active request
BUY_AGENT_WATCH_DAYS=30  # days a standing Buy-Agent watch runs before it ends by itself (changing it starts the time again)
LISTING_FEES_ENABLED=false  # true: new listings stay hidden until their monthly fee is paid (PRICING.md). Switch on only once the app build with the Listing fee screen is required
PREMIUM_ENABLED=false  # true: voice mode, Zeno's SMS, the Buying Agent, AI covers (after 2 free tries) and hosting auctions need a Plus/Pro/Elite plan, and plans are sold (PRICING.md). Only once the app build with the Premium screen is required
HOMESCREEN_VARIANT=a     # a | b — Flutter-only, read via --dart-define=HOMESCREEN_VARIANT=b at build time, not by the backend; listed here so it's documented alongside its backend counterpart above
