<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Required by SystemRingtone.kt: an incoming call vibrates alongside
         the ringtone, and is the ONLY indication at all when the phone is
         in vibrate mode. Without this the Vibrator call is a silent no-op,
         so a call to a phone on vibrate arrives with no signal whatsoever. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Backs NotificationService's incoming-call notification
         (fullScreenIntent: true) - without this, that flag can silently
         degrade to a normal heads-up notification instead of actually
         waking/covering the screen for a ringing call. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <!-- Keeps voice/video calls alive when the screen locks or the app
         loses foreground mid-call (see CallForegroundService.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <!-- Lets the app ask, once, to be left out of battery optimisation
         (NotificationService.maybeAskForBackgroundDelivery). On the
         aggressive Android builds common in Kenya, an optimised app that
         is closed often gets its pushes late or not at all - an incoming
         call that never rings. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>

    <!-- Required by permission_handler on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
    </queries>

    <!-- No backups of app data. Its preferences hold the sign-in tokens
         (and, in builds before 2026-09, the account password in plain
         text); Android's default auto-backup copied them into the user's
         Google Drive and onto new phones. allowBackup covers Android 11
         and below, dataExtractionRules Android 12 and up (where
         allowBackup alone no longer stops device-to-device transfer). -->
    <application
        android:label="BROKA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Store links (https://broka.co.ke/store/<name>, and its
                 products at /store/<name>/p/<id>) open in the app.
                 autoVerify makes them open without asking once
                 https://broka.co.ke/.well-known/assetlinks.json lists this
                 app's signing certificate. MainActivity passes the link to
                 lib/services/deep_link_service.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="broka.co.ke"/>
                <data android:host="www.broka.co.ke"/>
                <data android:pathPrefix="/store/"/>
            </intent-filter>
            <!-- Flutter's own deep-link routing stays off: links are routed by
                 DeepLinkService once the splash screen is done, not pushed
                 as raw route names on top of it. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Keeps the mic (and camera, for video calls) alive and exempt
             from background restrictions for the duration of a call. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera"/>

        <!-- Delivers Decline on the incoming-call notification (an action
             that doesn't open the app). flutter_local_notifications does
             not declare it itself; without it the button does nothing. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <!-- How Android draws a push itself (a message, a missed call, a
             deal update) while the app is closed: the white status-bar
             icon rather than the launcher square, BROKA's violet, and the
             Messages channel when a push names none. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_broka"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="broka_messages"/>
        <meta-data android:name="flutterEmbedding" android:value="2"/>
    </application>
</manifest>
