<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up draw their own splash, whatever windowBackground
         says. By default it is the launcher icon: the adaptive icon's navy
         background, cut to the phone's icon shape - the box around the logo
         people saw. Here it is the logo alone (transparent, 160dp inside the
         288dp canvas, so its glow stays within the 192dp circle Android
         keeps), on the same near-black the Flutter splash opens on. No
         windowSplashScreenIconBackgroundColor: setting one shrinks the icon
         to Android's 240dp size, and the logo would jump when Flutter's
         160dp one replaces it. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
